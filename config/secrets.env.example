# Apollo machine-local secrets template
# DO NOT commit the real secrets.env file.
# Windows production location:
#   C:\ProgramData\Apollo\config\secrets.env

# Required when POSTGRES_ENABLED=True.
POSTGRES_DATABASE_URL=postgresql://apollo_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/eyresqc_apollo
POSTGRES_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Provisioning/admin only. Normal GUI runtime should not need admin credentials.
POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:5432/postgres

# Optional legacy MongoDB URL. Only define this when an approved rollback/migration
# mode genuinely uses authenticated MongoDB. Otherwise the project default is enough.
# DATABASE_URL=mongodb://user:CHANGE_ME_PASSWORD@127.0.0.1:27017/
