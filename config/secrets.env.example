# Apollo machine-local secrets template.
# DO NOT place the real secrets file inside the project source folder.
# Recommended production location on Windows:
#   C:\ProgramData\Apollo\config\secrets.env
#
# Config precedence after the AP-001 patch:
#   OS environment > external secrets.env > project .env > defaults

# PostgreSQL runtime connection string used by the Apollo application.
POSTGRES_DATABASE_URL=postgresql://apollo_user:CHANGE_ME@127.0.0.1:5432/eyresqc_apollo

# PostgreSQL bootstrap/admin credentials. Only needed by setup tooling.
POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
POSTGRES_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Keep this only if the legacy database path is still required by your deployment.
DATABASE_URL=mongodb://localhost:27017/
