  "allowed_patterns": [
    "^AXIS_\\d+_(NAME|IP|POS_DB|POS_BYTE|POS_TYPE|ENABLED_DB|ENABLED_BYTE|ENABLED_BIT|FAULT_DB|FAULT_BYTE|FAULT_BIT|HOMED_DB|HOMED_BYTE|HOMED_BIT)$",
    "^RECIPE_TARGET_\\d+_(KEY|NAME|GROUP|AXIS_ID|TYPE|WRITE_DB|WRITE_BYTE)$",
    "^LIVE_LASER_[A-Z0-9]+_(PROFILES_PER_SCAN|LINE_RATE|EXPOSURE_US|REFLECTANCE_THRESHOLD|POWER|NOISE_LEVEL|FIR_SIZE|MEDIAN_FILTER|EXPECTED_DISPLACEMENT_Y_UM|Z_SCALE_UM)$"
  ],
  "secret_keys": [
    "POSTGRES_ADMIN_URL",
    "POSTGRES_APP_PASSWORD",
    "POSTGRES_DATABASE_URL"
  ],
  "deprecated_keys": {
    "RECIPE_ENTRY_BIT_ENABLED": "Legacy PLC recipe-entry bit. DB75 byte 290 is the Siemens recipe-name STRING start, not a BOOL command.",
    "RECIPE_ENTRY_BIT_DB": "Legacy companion setting for the removed recipe-entry BOOL.",
    "RECIPE_ENTRY_BIT_BYTE": "Legacy companion setting for the removed recipe-entry BOOL.",
    "RECIPE_ENTRY_BIT_BIT": "Legacy companion setting for the removed recipe-entry BOOL.",
    "RECIPE_ENTRY_BIT_PULSE_SEC": "Legacy companion setting for the removed recipe-entry BOOL."
  },
  "required_deployment_keys": [
    "APOLLO_RUNTIME_ROOT",
    "DATA_BACKEND",
    "POSTGRES_ENABLED",
    "PLC_IP",
    "APP_OK_DB",
    "APP_OK_BYTE",
    "APP_OK_BIT",
    "PLC_ACCEPT_DB",
    "PLC_ACCEPT_BYTE",
    "PLC_ACCEPT_BIT",
    "PLC_REJECT_DB",
    "PLC_REJECT_BYTE",
    "PLC_REJECT_BIT",
    "LIVE_MAIN_TRIGGER_DB",
    "LIVE_MAIN_TRIGGER_BYTE",
    "LIVE_MAIN_TRIGGER_BIT",
    "LIVE_BEAD_TRIGGER_DB",
    "LIVE_BEAD_TRIGGER_BYTE",
    "LIVE_BEAD_TRIGGER_BIT"
  ],
  "conditional_required": [
    {
      "name": "PostgreSQL runtime",
      "when": [
        {
          "key": "POSTGRES_ENABLED",
          "truthy": true
        }
      ],
      "keys": [
        "POSTGRES_DATABASE_URL"
      ]
    },
    {
      "name": "Sidewall1 camera serial",
      "when": [
        {
          "key": "CAM_SIDEWALL1_ENABLED",
          "truthy": true
        }
      ],
      "keys": [
        "CAM_SIDEWALL1_SERIAL"
      ]
    },
    {
      "name": "Sidewall2 camera serial",
      "when": [
        {
          "key": "CAM_SIDEWALL2_ENABLED",
          "truthy": true
        }
      ],
      "keys": [
        "CAM_SIDEWALL2_SERIAL"
      ]
    },
    {
      "name": "Innerwall camera serial",
      "when": [
        {
          "key": "CAM_INNERWALL_ENABLED",
          "truthy": true
        }
      ],
      "keys": [
        "CAM_INNERWALL_SERIAL"
      ]
    },
    {
      "name": "Tread camera serial",
      "when": [
        {
          "key": "CAM_TREAD_ENABLED",
          "truthy": true
        }
      ],
      "keys": [
        "CAM_TREAD_SERIAL"
      ]
    },
    {
      "name": "Bead camera serial",
      "when": [
        {
          "key": "CAM_BEAD_ENABLED",
          "truthy": true
        }
      ],
      "keys": [
        "CAM_BEAD_SERIAL"
      ]
    },
    {
      "name": "Required laser target serials",
      "when": [
        {
          "key": "REQUIRE_LASER",
          "truthy": true
        }
      ],
      "unless": [
        {
          "key": "TELEDYNE_LASER_MOCK",
          "truthy": true
        }
      ],
      "keys": [
        "LASER_CONNECTION_TARGET_SERIALS"
      ]
    },
    {
      "name": "Deferred Teledyne CTI for laser connection check",
      "severity": "WARNING",
      "when": [
        {
          "key": "REQUIRE_LASER",
          "truthy": true
        }
      ],
      "unless": [
        {
          "key": "TELEDYNE_LASER_MOCK",
          "truthy": true
        }
      ],
      "keys": [
        "TELEDYNE_CTI_PATH"
      ],
      "path_keys": [
        "TELEDYNE_CTI_PATH"
      ]
    },
    {
      "name": "Deferred Teledyne CTI for production live laser capture",
      "when": [
        {
          "key": "LIVE_LASER_CAPTURE_ENABLED",
          "truthy": true
        }
      ],
      "unless": [
        {
          "key": "TELEDYNE_LASER_MOCK",
          "truthy": true
        }
      ],
      "keys": [
        "TELEDYNE_CTI_PATH"
      ],
      "path_keys": [
        "TELEDYNE_CTI_PATH"
      ],
      "severity": "WARNING"
    }
  ],
  "documentation": {
    "project_example": ".env.example",
    "secret_example": "config/secrets.env.example"
  }
