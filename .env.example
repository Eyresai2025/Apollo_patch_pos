# Apollo Tyre Inspection deployment configuration template.
# Copy this file to .env and fill values for the target IPC.

APP_VERSION=v1.0
BUILD_NUMBER=
BUILD_DATE=
DEPLOYMENT=False

# =========================================================
# PATCHCORE LIVE INFERENCE
# =========================================================
# False: process five local side images from this folder when Start Live is clicked.
# Numbered mapping: 1=sidewall1, 2=sidewall2, 3=innerwall, 4=tread, 5=bead.
# True : use images captured from the real PLC/camera cycle.
LOCAL_INSPECTION_INPUT="media/raw images"

# Only Sidewall 1 is enabled now. Add views here after their runtime
# pipelines and artifacts are available.
PATCHCORE_ACTIVE_SIDES=sidewall1,sidewall2,innerwall,tread,bead
PATCHCORE_FEATURE_ROOT=feature_threshold
PATCHCORE_TEMPLATE_ROOT=template_extractor
PATCHCORE_TRAINING_ROOT=training
PATCHCORE_OFFSET_ROOT=offset_calibration
PATCHCORE_R_SOURCE_SIDE=sidewall1
PATCHCORE_MAX_PARALLEL_WORKERS=5
PATCHCORE_SIDEWALL_RESIZE_WIDTH=4036
PATCHCORE_SIDEWALL_RESIZE_HEIGHT=17920
PATCHCORE_R_TILE_HEIGHT=4200
PATCHCORE_R_TILE_WIDTH=4096
PATCHCORE_R_MATCH_THRESHOLD=0.70
PATCHCORE_R_MIN_BAND_HEIGHT=20
PATCHCORE_R_ROW_GAP=5
PATCHCORE_R_SEARCH_X_START_RATIO=0.0
PATCHCORE_R_SEARCH_X_END_RATIO=0.6
PATCHCORE_RESULT_JPEG_QUALITY=90
PATCHCORE_KEEP_GENERATED_PATCHES=False
PATCHCORE_SAVE_DEFECTIVE_PATCHES=True
PATCHCORE_DRAW_SCORE_LABELS=False
PATCHCORE_BOX_WIDTH=5

# Legacy MongoDB connection. It is not opened when both MongoDB switches below
# are False. Keep these values only while retaining the rollback database.
DATABASE_URL=mongodb://localhost:27017/
DATABASE_NAME=EyresQC_Apollo
GRIDFS_BUCKET=fs
DB_POOL_SIZE=50
DB_MIN_POOL_SIZE=10
DB_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000

PLC_IP=192.168.10.1
PLC_TYPE=Siemens S7-1500
PLC_RACK=0
PLC_SLOT=1
PLC_RETRY_COUNT=3
PLC_RETRY_DELAY_SEC=1.0

INFERENCE_DEVICE=cuda
ENABLE_WARMUP=True
WARMUP_ITER=2
INFERENCE_TIMEOUT=30
R_ALIGN_CONC=5
YOLO_CONC=5

MODEL_DIR=media/weights
CAPTURE_DIR=media/capture
OUTPUT_DIR=media/output
RECIPE_BACKUP_DIR=media/recipe_backups
LOG_DIR=logs

WEIGHT_FILE_Apollo=
WEIGHT_FILE_RE_ONNX=
WEIGHT_FILE_CLASS=

HEALTH_MONITOR_INTERVAL_MS=5000
STORAGE_MIN_FREE_GB=10
REQUIRE_LIGHTS=False
REQUIRE_LASER=False

CAM_SIDEWALL1_SERIAL=
CAM_SIDEWALL2_SERIAL=
CAM_INNERWALL_SERIAL=
CAM_TREAD_SERIAL=
CAM_BEAD_SERIAL=
CAM_SHARED_INNER_BEAD=False
CAM_TRIGGER_MODE=plc_software
CAM_PACKET_SIZE=9000
CAM_PACKET_DELAY=1000

# Software FFC applied after stitched capture and before returning images.
CAM_SOFTWARE_FFC_ENABLED=True
CAM_FFC_TARGET_MODE=PERCENTILE_95
CAM_FFC_GAIN_MIN=1.0
CAM_FFC_GAIN_MAX=15.99
CAM_FFC_ROW_BLOCK=512
CAM_FFC_WORKERS=1
CAM_FFC_FAIL_POLICY=raise

# Keep the full machine-specific PLC axis, recipe-target and trigger mappings
# from your approved deployment .env. The central manager exposes all keys,
# including keys not listed in this short template.

# Structured logging
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=True
LOG_TEXT_ENABLED=True
LOG_JSON_ENABLED=True
LOG_ERROR_ENABLED=True
LOG_FILE_NAME=app.log
LOG_JSON_FILE_NAME=app.jsonl
LOG_ERROR_FILE_NAME=error.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_REPEAT_WINDOW_SEC=5

# Role-based login and permissions
AUTH_ENABLED=True
AUTH_DB_PATH=data/security/apollo_security.db
AUTH_SESSION_TIMEOUT_MIN=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MIN=15
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_REQUIRE_COMPLEX_PASSWORD=True
AUTH_ALLOW_SELF_SIGNUP=False

# PostgreSQL Phase 5 production runtime configuration.
# Normal application startup uses PostgreSQL only. Legacy MongoDB settings are
# retained solely for an approved migration or emergency rollback.
DATA_BACKEND=POSTGRESQL
MONGODB_FALLBACK_ENABLED=False
MONGODB_MIGRATION_MODE=False

POSTGRES_ENABLED=True
POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:5432/postgres
POSTGRES_APP_USER=apollo_user
POSTGRES_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB_NAME=eyresqc_apollo
POSTGRES_DATABASE_URL=postgresql://apollo_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/eyresqc_apollo
POSTGRES_SCHEMA=apollo
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_POOL_TIMEOUT_SEC=30
POSTGRES_CONNECT_TIMEOUT_SEC=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_APPLICATION_NAME=Apollo_Tyre_Inspection_Edge

# =========================================================
# PRODUCTION LIVE AI-TEAM OPTIMIZED R / RESIZE SETTINGS
# Focus: Live button, DEPLOYMENT=True, actual PLC/camera machine.
# =========================================================
PATCHCORE_R_RECIPE_ROOT=R_Recipe
PATCHCORE_R_DETECTION_METHOD=fast
PATCHCORE_R_FAST_SCALE=1
PATCHCORE_R_FAST_SECOND_PAD=600
PATCHCORE_R_FAST_X_PAD=100
PATCHCORE_R_FAST_VERBOSE=False
PATCHCORE_R_FAST_FALLBACK_TO_TILED=False

# AI-team optimized maincycle uses sku_resize_dimensions.json.
# Preferred per-SKU location in this app:
# media/R_Recipe/<SKU>/sku_resize_dimensions.json
PATCHCORE_RESIZE_PROFILE_FILE=sku_resize_dimensions.json
# Optional absolute/relative override:
PATCHCORE_RESIZE_PROFILE_JSON=

PATCHCORE_PATCH_SCORING_MODE=ram_png
PATCHCORE_IMAGE_BATCH_SIZE=64
PATCHCORE_MEMORY_BANK_CHUNK_SIZE=20000
PATCHCORE_RESULT_PREVIEW_SCALE=0.5
PATCHCORE_DRAW_SCORE_LABELS=False

# Optional production laser profile apply. Camera profile is always applied.
# Laser profile is applied only if LIVE_APPLY_LASER_PROFILE=True or REQUIRE_LASER=True.
# Expected: media/Laser_Profiles/<SKU>/laser_profile.json
LIVE_APPLY_LASER_PROFILE=False
LIVE_REQUIRE_CAMERA_PROFILE=True
LIVE_REQUIRE_RESIZE_PROFILE=False


# Save at most two full-resolution inspection images concurrently.
APOLLO_IMAGE_SAVE_WORKERS=2
